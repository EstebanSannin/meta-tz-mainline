From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefano Viola <stefano.viola@toradex.com>
Date: Wed, 4 Nov 2026 23:55:00 +0100
Subject: [PATCH] arm64: dts: imx8mp: Run the VC8000E at the overdrive rate

imx8mp.dtsi carries the overdrive clock rates and imx8mp-nominal.dtsi
overrides them for nominal drive mode, as done for the G1 and G2 decoders.
The VC8000E encoder node used its nominal rate, 400 MHz, in imx8mp.dtsi.

Run it at its overdrive rate, 500 MHz from SYS_PLL2_1000M, as the NXP BSP
does, and keep 400 MHz from SYS_PLL1_800M in nominal drive mode. Encoding a
1080p frame takes 4.4 ms instead of 5.4 ms on a Verdin iMX8MP.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: Stefano Viola <stefano.viola@toradex.com>
Upstream-Status: Pending
---
diff --git a/arch/arm64/boot/dts/freescale/imx8mp-nominal.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-nominal.dtsi
index f269f7a..276b930 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-nominal.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-nominal.dtsi
@@ -101,6 +101,12 @@
 	assigned-clock-rates = <500000000>;
 };
 
+&vpu_vc8000e {
+	assigned-clocks = <&clk IMX8MP_CLK_VPU_VC8000E>;
+	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_800M>;
+	assigned-clock-rates = <400000000>;
+};
+
 &vpumix_blk_ctrl {
 	assigned-clocks = <&clk IMX8MP_VPU_PLL>, <&clk IMX8MP_CLK_VPU_BUS>;
 	assigned-clock-parents = <0>, <&clk IMX8MP_VPU_PLL_OUT>;
diff --git a/arch/arm64/boot/dts/freescale/imx8mp.dtsi b/arch/arm64/boot/dts/freescale/imx8mp.dtsi
index 9424707..fddd04f 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp.dtsi
@@ -2369,8 +2369,8 @@
 			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk IMX8MP_CLK_VPU_VC8KE_ROOT>;
 			assigned-clocks = <&clk IMX8MP_CLK_VPU_VC8000E>;
-			assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_800M>;
-			assigned-clock-rates = <400000000>;
+			assigned-clock-parents = <&clk IMX8MP_SYS_PLL2_1000M>;
+			assigned-clock-rates = <500000000>;
 			power-domains = <&vpumix_blk_ctrl IMX8MP_VPUBLK_PD_VC8000E>;
 		};
 
-- 
