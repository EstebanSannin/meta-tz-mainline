From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stefano Viola <stefano.viola@toradex.com>
Date: Thu, 19 Nov 2026 22:51:28 +0100
Subject: [PATCH 17/18] arm64: dts: imx8mp: VC8000E overdrive rate, ISI on
 Verdin

Run the VC8000E encoder at 500 MHz, its overdrive rate, as the NXP BSP
does, and keep 400 MHz in imx8mp-nominal.dtsi. A 1080p frame takes 20%
less time.

Enable the ISI on the Verdin module, so it can scale and convert colours
memory-to-memory without a camera (v4l2convert).

Signed-off-by: Stefano Viola <stefano.viola@toradex.com>
Upstream-Status: Pending
---
 arch/arm64/boot/dts/freescale/imx8mp-nominal.dtsi | 6 ++++++
 arch/arm64/boot/dts/freescale/imx8mp-verdin.dtsi  | 5 +++++
 arch/arm64/boot/dts/freescale/imx8mp.dtsi         | 4 ++--
 3 files changed, 13 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/freescale/imx8mp-nominal.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-nominal.dtsi
index f269f7a004..276b930a7c 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-nominal.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-nominal.dtsi
@@ -101,6 +101,12 @@
 	assigned-clock-rates = <500000000>;
 };
 
+&vpu_vc8000e {
+	assigned-clocks = <&clk IMX8MP_CLK_VPU_VC8000E>;
+	assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_800M>;
+	assigned-clock-rates = <400000000>;
+};
+
 &vpumix_blk_ctrl {
 	assigned-clocks = <&clk IMX8MP_VPU_PLL>, <&clk IMX8MP_CLK_VPU_BUS>;
 	assigned-clock-parents = <0>, <&clk IMX8MP_VPU_PLL_OUT>;
diff --git a/arch/arm64/boot/dts/freescale/imx8mp-verdin.dtsi b/arch/arm64/boot/dts/freescale/imx8mp-verdin.dtsi
index 9fee2cf9ef..ffe60f4240 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp-verdin.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp-verdin.dtsi
@@ -796,6 +796,11 @@
 	single-master;
 };
 
+/* Memory-to-memory scaling and colour conversion, also without a camera */
+&isi_0 {
+	status = "okay";
+};
+
 /* Verdin PCIE_1 */
 &pcie {
 	pinctrl-names = "default";
diff --git a/arch/arm64/boot/dts/freescale/imx8mp.dtsi b/arch/arm64/boot/dts/freescale/imx8mp.dtsi
index 94247070c1..fddd04f109 100644
--- a/arch/arm64/boot/dts/freescale/imx8mp.dtsi
+++ b/arch/arm64/boot/dts/freescale/imx8mp.dtsi
@@ -2369,8 +2369,8 @@
 			interrupts = <GIC_SPI 30 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&clk IMX8MP_CLK_VPU_VC8KE_ROOT>;
 			assigned-clocks = <&clk IMX8MP_CLK_VPU_VC8000E>;
-			assigned-clock-parents = <&clk IMX8MP_SYS_PLL1_800M>;
-			assigned-clock-rates = <400000000>;
+			assigned-clock-parents = <&clk IMX8MP_SYS_PLL2_1000M>;
+			assigned-clock-rates = <500000000>;
 			power-domains = <&vpumix_blk_ctrl IMX8MP_VPUBLK_PD_VC8000E>;
 		};
 
